#include <QVariantMap>

// No secret crosses here: the RPC cookie, when exposeRpc is on, stays in the node's data directory.
class BitcoindBackend
{
    PROP(QString state READONLY)          // stopped|starting|running|flushing|stopping|failed|unavailable
    PROP(QString network READONLY)        // the network the view shows and would start
    PROP(QString networksJson READONLY)   // mainnet, testnet4, signet, regtest
    PROP(QString statusJson READONLY)     // status(), or the last bitcoindStateChanged payload
    PROP(QString configJson READONLY)     // getConfig(network); "" while a network switch loads
    PROP(QString logText READONLY)
    PROP(QString lastError READONLY)
    PROP(bool busy READONLY)              // start or stop in flight
    PROP(int stopSecs READONLY)           // seconds since stop() was asked, while it runs

    SLOT(void selectNetwork(QString network))
    SLOT(void saveConfig(QString configJson))
    SLOT(void start())
    SLOT(void stop())
    SLOT(void refresh())
}
